# FRAME Backend Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# Server
PORT=3001
NODE_ENV=development

# Frontend origin (used for CORS)
FRONTEND_URL=http://localhost:5173

# Database (from Supabase → Settings → Database) — used from Phase 5 onward
DATABASE_URL=postgresql://postgres:[password]@db.[ref].supabase.co:5432/postgres?pgbouncer=true&connection_limit=1
DIRECT_URL=postgresql://postgres:[password]@db.[ref].supabase.co:5432/postgres

# Supabase — used from Phase 4 onward
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# TMDB — REQUIRED for Phase 3 movie data
# This must be the v4 "Read Access Token" (a long JWT-style string), NOT the v3 API key.
# Get it from: https://www.themoviedb.org/settings/api → "API Read Access Token"
TMDB_API_READ_ACCESS_TOKEN=your-tmdb-read-access-token
